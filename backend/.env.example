# Database Settings
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragcoon_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Qdrant Cloud Settings
QDRANT_URL=https://your-qdrant-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# App Settings
APP_NAME=RAGcoon Backend
DEBUG=True

# JWT Auth (change JWT_SECRET in real deployments)
JWT_SECRET=change-me-ragcoon-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Startup seed — Administrator (Sprint 2)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com
