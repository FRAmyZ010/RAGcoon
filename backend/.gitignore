# ==========================================
# Environments & Secrets (ห้าม Push ขึ้น Git)
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# Python & Byte-compiled / Optimized files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
v-env/
ENV/
env/
.venv/
env.bak/
venv.bak/

# ==========================================
# IDEs & Code Editors
# ==========================================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.idea/
*.iws
*.iml
*.ipr

# ==========================================
# Storage & Local Documents (PDF Uploads / Temp)
# ==========================================
storage/*
!storage/.gitkeep
storage/pdfs/*
!storage/pdfs/.gitkeep

# ==========================================
# Docker & Database local persistent data
# ==========================================
postgres_data/
.docker/

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.nox/
.hypothesis/

# ==========================================
