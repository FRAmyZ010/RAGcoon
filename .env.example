# ==============================================================================
# RAGcoon Unified Environment Variables Configuration (.env.example)
# Copy this file to .env or backend/.env before running docker-compose
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=ragcoonadmin
POSTGRES_PASSWORD=ragcoonpassword123
POSTGRES_DB=ragcoon_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- pgAdmin Web Console ---
PGADMIN_DEFAULT_EMAIL=admin@ragcoon.local
PGADMIN_DEFAULT_PASSWORD=adminpassword123

# --- Qdrant Vector Cloud / Local Instance ---
QDRANT_URL=https://your-cluster.qdrant.io/
QDRANT_API_KEY=your-qdrant-api-key
COLLECTION_NAME=embedding_evaluation
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Active LLM Provider Selection (ollama, gemini, openai) ---
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b

# --- Local Ollama Settings ---
OLLAMA_BASE_URL=http://localhost:11434/
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=4096

# --- Google Gemini Cloud API ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI ChatGPT Cloud API ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- RAG Hyperparameters Defaults ---
RETRIEVAL_TOP_K=15
RERANK_TOP_N=5

# --- JWT Authentication & Admin Seed ---
JWT_SECRET=supersecret-ragcoon-jwt-token-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@ragcoon.local

# --- Application Settings ---
APP_NAME=RAGcoon Senior Project Management System
DEBUG=False
