{
  "name": "ragcoon",
  "private": true,
  "version": "0.0.0",
  "description": "RAGcoon monorepo helper scripts",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:frontend": "npm --prefix frontend run dev",
    "stack:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start.ps1",
    "stack:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop.ps1",
    "docker:up": "docker compose -p ragcoon up -d --build",
    "docker:down": "docker compose -p ragcoon down",
    "docker:logs": "docker compose -p ragcoon logs -f"
  }
}
